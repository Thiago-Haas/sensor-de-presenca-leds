[
    {
        "id": "flow",
        "type": "tab",
        "label": "Alturas da porta"
    },
    {
        "id": "broker",
        "type": "mqtt-broker",
        "name": "Mosquitto nesta maquina",
        "broker": "127.0.0.1",
        "port": "1883",
        "clientid": "dashboard-alturas",
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "base",
        "type": "ui-base",
        "name": "Alturas",
        "path": "/dashboard",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ],
        "showPathInSidebar": false,
        "navigationStyle": "default"
    },
    {
        "id": "theme",
        "type": "ui-theme",
        "name": "Tema",
        "colors": {
            "surface": "#ffffff",
            "primary": "#2563eb",
            "bgPage": "#f1f5f9",
            "groupBg": "#ffffff",
            "groupOutline": "#cbd5e1"
        },
        "sizes": {
            "density": "default",
            "pagePadding": "12px",
            "groupGap": "12px",
            "groupBorderRadius": "8px",
            "widgetGap": "12px"
        }
    },
    {
        "id": "page",
        "type": "ui-page",
        "name": "Alturas estimadas",
        "ui": "base",
        "path": "/alturas",
        "icon": "human-male-height",
        "layout": "grid",
        "theme": "theme",
        "order": 1,
        "className": "",
        "visible": true,
        "disabled": false,
        "breakpoints": [
            {
                "name": "Default",
                "px": "0",
                "cols": "3"
            },
            {
                "name": "Tablet",
                "px": "576",
                "cols": "6"
            },
            {
                "name": "Desktop",
                "px": "1024",
                "cols": "12"
            }
        ]
    },
    {
        "id": "group",
        "type": "ui-group",
        "name": "Passagens — estimativas em cm",
        "page": "page",
        "width": "12",
        "height": "1",
        "order": 1,
        "showTitle": true,
        "visible": true,
        "disabled": false,
        "groupType": "default"
    },
    {
        "id": "input",
        "type": "mqtt in",
        "z": "flow",
        "name": "Alturas",
        "topic": "porta/porta-01/altura",
        "qos": "1",
        "datatype": "json",
        "broker": "broker",
        "x": 100,
        "y": 100,
        "wires": [
            [
                "validate"
            ]
        ]
    },
    {
        "id": "validate",
        "type": "function",
        "z": "flow",
        "name": "Validar e registrar recebimento",
        "func": "const p = msg.payload;\nif (!p || typeof p !== 'object' || typeof p.height_cm !== 'number' ||\n    !Number.isFinite(p.height_cm) || !Number.isFinite(p.sensor_height_cm) ||\n    p.height_cm < 0 || p.height_cm >= p.sensor_height_cm ||\n    p.sensor_height_cm > 400 || typeof p.event_id !== 'string' || p.estimated !== true) {\n    node.warn('Registro de altura invalido'); return null;\n}\nlet seen = context.get('seen') || [];\nif (seen.includes(p.event_id)) return null;\nseen.push(p.event_id); context.set('seen', seen.slice(-1000));\nconst record = {...p, received_at: new Date().toISOString()};\nconst history = context.get('history') || [];\nhistory.unshift(record); context.set('history', history.slice(0,100));\nlet tally = context.get('tally') || {};\nconst label = p.person === 'ambiguo' && Array.isArray(p.candidatos)\n    ? p.candidatos.map(c => c.nome).join(' / ') + ' (ambiguo)'\n    : (p.person || 'desconhecido');\ntally[label] = (tally[label] || 0) + 1;\ncontext.set('tally', tally);\nreturn [{payload: p.height_cm, topic: 'Altura estimada'},\n        {payload: history.slice(0,100)},\n        {payload: JSON.stringify(record)},\n        {payload: p},\n        {payload: tally}];",
        "outputs": 5,
        "x": 340,
        "y": 100,
        "wires": [
            [
                "chart"
            ],
            [
                "history"
            ],
            [
                "file"
            ],
            [
                "person-format"
            ],
            [
                "tally-table"
            ]
        ]
    },
    {
        "id": "chart",
        "type": "ui-chart",
        "z": "flow",
        "group": "group",
        "name": "Alturas",
        "label": "Altura estimada por recebimento (cm)",
        "order": 2,
        "chartType": "scatter",
        "category": "topic",
        "categoryType": "msg",
        "xAxisLabel": "Recebimento no servidor",
        "xAxisProperty": "",
        "xAxisPropertyType": "timestamp",
        "xAxisType": "time",
        "xAxisFormat": "{HH}:{mm}:{ss}",
        "yAxisLabel": "cm",
        "yAxisProperty": "payload",
        "yAxisPropertyType": "msg",
        "ymin": "0",
        "ymax": "250",
        "action": "append",
        "pointShape": "circle",
        "pointRadius": 4,
        "showLegend": false,
        "removeOlder": "24",
        "removeOlderUnit": "3600",
        "removeOlderPoints": "100",
        "width": "12",
        "height": "5",
        "x": 620,
        "y": 60,
        "wires": [
            []
        ]
    },
    {
        "id": "history",
        "type": "ui-template",
        "z": "flow",
        "group": "group",
        "name": "Historico",
        "order": 3,
        "width": "12",
        "height": "5",
        "format": "<template>\n<div style=\"padding:12px;overflow:auto\">\n<p>Estimativa ultrassônica. Horários representam o recebimento no servidor.</p>\n<p v-if=\"!msg?.payload?.length\">Aguardando passagens medidas.</p>\n<table v-else style=\"width:100%;text-align:left\">\n<thead><tr><th>Recebido em (UTC)</th><th>Altura estimada</th><th>Pessoa</th></tr></thead>\n<tbody><tr v-for=\"row in msg.payload\" :key=\"row.event_id\">\n<td>{{ row.received_at }}</td><td>{{ row.height_cm.toFixed(1) }} cm</td>\n<td>\n<span v-if=\"row.person === 'desconhecido'\">Desconhecido</span>\n<span v-else-if=\"row.person === 'ambiguo' && row.candidatos && row.candidatos.length === 2\">{{ row.candidatos[0].nome }} ({{ Math.round(row.candidatos[0].prob*100) }}%) / {{ row.candidatos[1].nome }} ({{ Math.round(row.candidatos[1].prob*100) }}%)</span>\n<span v-else>{{ row.person }}</span>\n</td>\n</tr></tbody></table>\n</div>\n</template>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 620,
        "y": 120,
        "wires": [
            []
        ]
    },
    {
        "id": "file",
        "type": "file",
        "z": "flow",
        "name": "Historico persistente JSONL",
        "filename": "/home/haas/.node-red/data/alturas.jsonl",
        "filenameType": "str",
        "appendNewline": true,
        "createDir": true,
        "overwriteFile": "false",
        "encoding": "utf8",
        "x": 640,
        "y": 180,
        "wires": [
            []
        ]
    },
    {
        "id": "status",
        "type": "mqtt in",
        "z": "flow",
        "name": "Estado MQTT",
        "topic": "porta/porta-01/status",
        "qos": "1",
        "datatype": "utf8",
        "broker": "broker",
        "x": 100,
        "y": 260,
        "wires": [
            [
                "heartbeat-watch"
            ]
        ]
    },
    {
        "id": "status-text",
        "type": "ui-text",
        "z": "flow",
        "group": "group",
        "order": 1,
        "width": "12",
        "height": "1",
        "name": "Sinal de vida",
        "label": "ESP32 — sinal de vida",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 400,
        "y": 260,
        "wires": []
    },
    {
        "id": "heartbeat-in",
        "type": "mqtt in",
        "z": "flow",
        "name": "Heartbeat ESP32",
        "topic": "porta/porta-01/heartbeat",
        "qos": "0",
        "datatype": "json",
        "broker": "broker",
        "x": 140,
        "y": 340,
        "wires": [
            [
                "heartbeat-watch"
            ]
        ]
    },
    {
        "id": "heartbeat-tick",
        "type": "inject",
        "z": "flow",
        "name": "Verificar a cada segundo",
        "props": [
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "topic": "check",
        "repeat": "1",
        "once": true,
        "onceDelay": "0.5",
        "x": 150,
        "y": 400,
        "wires": [
            [
                "heartbeat-watch"
            ]
        ]
    },
    {
        "id": "heartbeat-watch",
        "type": "function",
        "z": "flow",
        "name": "Vivo / sem resposta (15 s)",
        "func": "const now = Date.now();\nlet last = context.get('last') || null;\nlet offline = context.get('offline') || false;\nif (msg.topic === 'porta/porta-01/status' && msg.payload === 'offline') {\n    offline = true;\n    last = null;\n}\nif (msg.topic === 'porta/porta-01/heartbeat' && !msg.retain) {\n    const p = msg.payload;\n    if (p && typeof p === 'object' && Number.isFinite(p.uptime_ms) &&\n        p.uptime_ms >= 0 && typeof p.sensor_ok === 'boolean') {\n        last = {at: now, sensorOk: p.sensor_ok, rssi: Number.isFinite(p.rssi_dbm) ? p.rssi_dbm : null};\n        offline = false;\n    }\n}\ncontext.set('last', last);\ncontext.set('offline', offline);\nconst rssiSuffix = (last && last.rssi !== null) ? (' · Wi-Fi ' + last.rssi + ' dBm') : '';\nif (offline) msg.payload = '🔴 Offline';\nelse if (!last) msg.payload = '⚪ Aguardando sinal de vida';\nelse if (now - last.at >= 15000) msg.payload = '🔴 Sem resposta há ' + Math.floor((now-last.at)/1000) + ' s' + rssiSuffix;\nelse msg.payload = (last.sensorOk ? '🟢 Vivo · sensor com eco' : '🟡 Vivo · sensor sem eco recente') + rssiSuffix + ' · recebido há ' + Math.floor((now-last.at)/1000) + ' s';\nreturn msg;\n",
        "initialize": "context.set('last', null); context.set('offline', false);",
        "outputs": 1,
        "x": 430,
        "y": 340,
        "wires": [
            [
                "status-text"
            ]
        ]
    },
    {
        "id": "calibration-in",
        "type": "mqtt in",
        "z": "flow",
        "name": "Distancia calibrada",
        "topic": "porta/porta-01/calibration",
        "qos": "1",
        "datatype": "json",
        "broker": "broker",
        "x": 160,
        "y": 480,
        "wires": [
            [
                "calibration-format"
            ]
        ]
    },
    {
        "id": "calibration-format",
        "type": "function",
        "z": "flow",
        "name": "Mostrar calibracao",
        "func": "const p = msg.payload;\nif (!p || typeof p !== 'object' || !Number.isFinite(p.distance_cm) ||\n    p.distance_cm < 0 || p.distance_cm > 400 || typeof p.saved !== 'boolean') return null;\nconst labels = {\n    default: 'valor configurado', saved: 'calibração salva', measuring: 'calibrando — deixe a passagem livre',\n    unstable: 'leituras instáveis — valor anterior mantido',\n    no_echo: 'sem leituras suficientes — valor anterior mantido',\n    save_failed: 'erro ao salvar — valor anterior mantido'\n};\nif (!Object.prototype.hasOwnProperty.call(labels, p.state)) return null;\nmsg.payload = p.distance_cm.toFixed(1) + ' cm · ' + labels[p.state];\nreturn msg;",
        "outputs": 1,
        "x": 420,
        "y": 480,
        "wires": [
            [
                "calibration-text"
            ]
        ]
    },
    {
        "id": "calibration-text",
        "type": "ui-text",
        "z": "flow",
        "group": "group",
        "order": 0,
        "width": "12",
        "height": "1",
        "name": "Distancia ao chao",
        "label": "Distância sensor → chão (último valor informado)",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 690,
        "y": 480,
        "wires": []
    },
    {
        "id": "person-format",
        "type": "function",
        "z": "flow",
        "name": "Formatar pessoa identificada",
        "func": "const p = msg.payload;\nlet text;\nif (p.person === 'desconhecido') {\n    text = '❔ Desconhecido (pico ' + p.height_cm.toFixed(1) + ' cm)';\n} else if (p.person === 'ambiguo' && Array.isArray(p.candidatos) && p.candidatos.length === 2) {\n    const [a, b] = p.candidatos;\n    text = '❓ Ambíguo: ' + a.nome + ' (' + Math.round(a.prob*100) + '%) ou ' + b.nome + ' (' + Math.round(b.prob*100) + '%)';\n} else {\n    text = '✅ ' + p.person + ' (' + p.height_cm.toFixed(1) + ' cm)';\n}\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 220,
        "wires": [
            [
                "person-text"
            ]
        ]
    },
    {
        "id": "person-text",
        "type": "ui-text",
        "z": "flow",
        "group": "group",
        "order": 4,
        "width": "12",
        "height": "1",
        "name": "Ultima pessoa identificada",
        "label": "Última passagem identificada",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "wires": []
    },
    {
        "id": "tally-table",
        "type": "ui-template",
        "z": "flow",
        "group": "group",
        "name": "Passagens por pessoa",
        "order": 5,
        "width": "12",
        "height": "5",
        "format": "<template>\n<div style=\"padding:12px;overflow:auto\">\n<p v-if=\"!msg?.payload || !Object.keys(msg.payload).length\">Ainda sem passagens contadas nesta sessão do Node-RED.</p>\n<table v-else style=\"width:100%;text-align:left\">\n<thead><tr><th>Pessoa</th><th>Passagens</th></tr></thead>\n<tbody><tr v-for=\"(count, nome) in msg.payload\" :key=\"nome\">\n<td>{{ nome }}</td><td>{{ count }}</td>\n</tr></tbody></table>\n</div>\n</template>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 620,
        "y": 260,
        "wires": [
            []
        ]
    }
]
